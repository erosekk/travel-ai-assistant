# =============================================
# Travel AI Assistant — Environment Variables
# =============================================
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to GitHub!

# Anthropic Claude API Key
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: set to "true" to allow direct browser API calls (dev only)
# In production, always use the Next.js API route (/app/api/generate)
NEXT_PUBLIC_USE_PROXY=true
